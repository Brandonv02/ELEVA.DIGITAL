# ELEVA — variables de entorno
# Copia este archivo a `.env.local` y rellena únicamente los datos confirmados.
# No guardar valores reales en este ejemplo.

# URL pública final. Se usa para canonical, sitemap, robots y Open Graph.
NEXT_PUBLIC_SITE_URL=

# WhatsApp en formato internacional, solo dígitos.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# Datos de contacto opcionales.
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CITY=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Verificación opcional de Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
